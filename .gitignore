# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
*.tsbuildinfo

# Node
/node_modules
npm-debug.log
yarn-error.log
package-lock.json.bak

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code / Cursor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/mcp.json

# Graphify (grafo, caché y memoria generados)
/graphify-out/

# Angular / Vitest
.angular/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
.vite/

# System files
.DS_Store
Thumbs.db
desktop.ini

# Variables locales y secretos
.env
.env.*
!.env.example
!.env.*.example

# Configuración personal de entornos
/src/environments/*.local.ts

# Reportes y resultados de pruebas de navegador
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Logs
*.log

# Archivos temporales del editor
*.swp
*.swo
*~

# Copia de respaldo creada durante la configuración
/angular.generado-cli.backup.json
